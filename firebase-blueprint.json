{
  "entities": {
    "userPreference": {
      "title": "User Preference",
      "description": "User specific app settings and profile details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "currency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "theme", "currency"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "An income or expense transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "amount", "category", "date", "description"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userPreference",
      "description": "Preferences for a single user document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Subcollection of transactions for a user"
    }
  }
}
